APP_ENV=development
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
REDIS_URL=redis://localhost:6379/0
REQUESTS_PER_MINUTE=120
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=rag
S3_SECRET_KEY=agentic-rag-secret
S3_BUCKET=rag-documents
WEAVIATE_URL=https://your-cluster.weaviate.network
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=FilingSection
# Neo4j runs as a local Docker container (see compose.yaml's neo4j service);
# this host-side URI matches its published bolt port for `uv run` dev outside
# Compose. Inside Compose, the api/worker containers use neo4j://neo4j:7687.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentic-rag-secret
OIDC_ISSUER=
OIDC_AUDIENCE=agentic-rag
OIDC_JWKS_URL=
DEV_AUTH=true
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-rag
# Self-hosted tracing/eval via Arize Phoenix (see compose.yaml's phoenix
# service, UI at localhost:6006) -- an alternative to LangSmith that needs no
# external account or quota. Only one of LANGCHAIN_TRACING_V2/PHOENIX_ENABLED
# should be true at a time; both can auto-instrument the same LangChain runs.
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=agentic-rag
# LiteLLM auto-discovers provider credentials from their own env var (below)
# when LLM_API_KEY is left unset -- see backend/app/components/llm.py.
MINIMAX_API_KEY=
# To swap providers, change LLM_FLASH_MODEL/LLM_PRO_MODEL to that provider's
# LiteLLM-prefixed model string (e.g. deepseek/deepseek-v4-flash) and set its
# credential env var (e.g. DEEPSEEK_API_KEY) -- no code change needed.
DEEPSEEK_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_FLASH_MODEL=minimax/MiniMax-M2.7-highspeed
LLM_PRO_MODEL=minimax/MiniMax-M3
# Update these calibration values when provider pricing changes. Note:
# M2.7-highspeed is a premium low-latency variant that costs MORE per token
# than M3 ($0.60/$2.40 vs $0.30/$1.20) -- not the usual cheap-flash pattern.
LLM_FLASH_INPUT_USD_PER_MILLION=0.60
LLM_FLASH_OUTPUT_USD_PER_MILLION=2.40
LLM_PRO_INPUT_USD_PER_MILLION=0.30
LLM_PRO_OUTPUT_USD_PER_MILLION=1.20
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
VOYAGE_RERANK_MODEL=rerank-2.5-lite
